# Porta HTTP do orquestrador
PORT=8080
# Token Bearer exigido por toda a API (POC: um token só; troque por OIDC/JWT)
API_TOKEN=troque-me

# Driver de sandbox: "docker" (um container por tarefa) ou "external" (aponta para um kilo serve já rodando)
SANDBOX_DRIVER=docker
# Imagem gerada por `npm run sandbox:build`
SANDBOX_IMAGE=squad-sandbox:dev
# Rede docker opcional (ex.: uma rede sem saída exceto o gateway do LLM)
SANDBOX_NETWORK=
# No Compose, acessa sandboxes pelo DNS da rede Docker; fora dele, usa loopback.
SANDBOX_USE_CONTAINER_DNS=false
# Limites por container
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
# Isolamento nativo do Kilo (bubblewrap) dentro do container. "true" exige subir o container com
# seccomp/apparmor/systempaths=unconfined; "false" desliga o bwrap e confia só no container.
SANDBOX_NATIVE_ISOLATION=false
# Variáveis do host repassadas para a sandbox (chaves do provedor de LLM, token do GitHub...)
# Claude Code usa ANTHROPIC_API_KEY (ou CLAUDE_CODE_OAUTH_TOKEN); Codex usa CODEX_API_KEY ou OPENAI_API_KEY.
SANDBOX_ENV_PASSTHROUGH=ANTHROPIC_API_KEY,CLAUDE_CODE_OAUTH_TOKEN,OPENAI_API_KEY,CODEX_API_KEY,OPENROUTER_API_KEY,KILO_API_KEY,GITHUB_TOKEN

# Harnesses oferecidos na UI (kilo, claude-code, codex) e o que vem marcado
HARNESSES=kilo,claude-code,codex
DEFAULT_HARNESS=kilo

# Driver "external": URL e senha de um `kilo serve` já de pé (útil para dev e para o mock)
KILO_EXTERNAL_URL=http://127.0.0.1:4096
# ...e da ponte de cada harness (vazio = mesma URL do Kilo). A senha é a mesma (KILO_EXTERNAL_PASSWORD).
EXTERNAL_URL_CLAUDE_CODE=
EXTERNAL_URL_CODEX=
KILO_EXTERNAL_PASSWORD=
KILO_EXTERNAL_DIRECTORY=

# Agente primário que recebe o prompt da tarefa (arquivo .kilo/agents/<nome>.md)
SQUAD_LEAD_AGENT=squad-lead
# Modelo padrão opcional no formato provider/model (vazio = default do kilo.jsonc)
DEFAULT_MODEL=
# Modelo padrão das pontes (vazio = padrão do Claude Code / do Codex). Ex.: sonnet, gpt-5-codex
CLAUDE_CODE_MODEL=
CODEX_MODEL=
# Sandbox próprio do Codex dentro do container (danger-full-access = confia só no container)
CODEX_SANDBOX_MODE=danger-full-access

# Tarefas e logs de eventos (replay) em arquivo: <DATA_DIR>/tasks/<id>/{task.json,events.jsonl}.
# Padrão .data; vazio = só memória (some ao reiniciar).
DATA_DIR=.data

# Encerra sandboxes ociosas após N minutos
IDLE_TTL_MINUTES=30
