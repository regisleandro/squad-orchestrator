{
  "$schema": "https://app.aicockpit.ai/config.json",
  "shared_agent_board": true,
  "sandbox": {
    "enabled": false
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "ask",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "npm test*": "allow",
      "npm run *": "allow",
      "git push*": "ask"
    }
  }
}
